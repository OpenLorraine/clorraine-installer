<?xml version="1.0" encoding="UTF-8"?>
<!--
    Installer identity for every Clorraine installer.

    The build tool replaces <Version> in a staging copy with the Clorraine
    release version. The committed value is a development placeholder.

    Online component repositories are added here once a published Qt Installer
    Framework repository exists. The first builds are offline installers that
    embed the selected payload.
-->
<Installer>
    <Name>Clorraine</Name>
    <Version>0.0.0-dev</Version>
    <Title>Clorraine</Title>
    <Publisher>OpenLorraine</Publisher>
    <ProductUrl>https://github.com/OpenLorraine/clorraine</ProductUrl>
    <TargetDir>@HomeDir@/Clorraine</TargetDir>
    <StartMenuDir>Clorraine</StartMenuDir>
    <MaintenanceToolName>ClorraineMaintenanceTool</MaintenanceToolName>
</Installer>
