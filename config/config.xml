<?xml version="1.0" encoding="UTF-8"?>
<!--
    Installer identity for every Clorraine installer.

    <Version> identifies the installer build. It is deliberately independent
    of the compiler version: the online installer always installs the latest
    compiler components from the stable channel.

    The repository URL contains a {platform} placeholder that the build tool
    replaces with the build host's operating system and architecture slug. Qt
    Installer Framework repositories are per platform because component
    payloads are platform specific. Pass the repository URL option to bake in
    a different location, such as an external bucket or a local test server.
-->
<Installer>
    <Name>Clorraine</Name>
    <Version>1.0.0</Version>
    <Title>Clorraine</Title>
    <Publisher>OpenLorraine</Publisher>
    <ProductUrl>https://github.com/OpenLorraine/clorraine</ProductUrl>
    <TargetDir>@HomeDir@/Clorraine</TargetDir>
    <StartMenuDir>Clorraine</StartMenuDir>
    <MaintenanceToolName>ClorraineMaintenanceTool</MaintenanceToolName>
    <RemoteRepositories>
        <Repository>
            <Url>https://openlorraine.github.io/clorraine-installer/repository/{platform}/</Url>
            <Enabled>1</Enabled>
            <DisplayName>Clorraine stable channel</DisplayName>
        </Repository>
    </RemoteRepositories>
</Installer>
